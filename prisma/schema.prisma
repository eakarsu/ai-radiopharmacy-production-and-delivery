 status String @default("Draft")
 productionDayId String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([createdAt])
 @@index([productionDayId])
 linkedRadiopharmacyOrderId RadiopharmacyOrder @relation("OrderLotAssignment_radiopharmacyOrderId", fields: [radiopharmacyOrderId], references: [id], onDelete: Restrict)
 linkedProductionLotId ProductionLot @relation("OrderLotAssignment_productionLotId", fields: [productionLotId], references: [id], onDelete: Restrict)
 linkedProductionDayId ProductionDay @relation("OrderLotAssignment_productionDayId", fields: [productionDayId], references: [id], onDelete: Restrict)
}

