 @@index([createdAt])
 @@index([productionDayId])
 linkedRadiopharmacyOrderId RadiopharmacyOrder @relation("DeliveryReceipt_radiopharmacyOrderId", fields: [radiopharmacyOrderId], references: [id], onDelete: Restrict)
 linkedProductionDayId ProductionDay @relation("DeliveryReceipt_productionDayId", fields: [productionDayId], references: [id], onDelete: Restrict)
